# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_CLIENT_ID: Required for Gmail OAuth to scan real emails.
VITE_GOOGLE_CLIENT_ID=""

# VITE_GOOGLE_MAPS_API_KEY: Optional for Google Maps Platform 3D & photorealistic satellite view.
# Prototyping uses free Maps Demo Key or interactive Canvas 3D Cyber Globe fallback.
VITE_GOOGLE_MAPS_API_KEY=""

# IPGEOLOCATION_API_KEY: Optional API key for https://ipgeolocation.io IP Geolocation API.
# If provided, high-precision carrier, ASN, and geo coordinates are queried via ipgeolocation.io with fallback to multi-provider telemetry.
IPGEOLOCATION_API_KEY=""

# URLSCAN_API_KEY: urlscan.io API Key for automated URL sandbox-analysis.
# Obtain a free API key at https://urlscan.io/user/profile
# Keep this secret; never expose to frontend or Chrome extension.
URLSCAN_API_KEY=""

# URLSCAN_VISIBILITY: Scan visibility on urlscan.io ('unlisted' | 'private' | 'public').
# Default: 'unlisted' ensures links are not indexed in public search feeds while keeping privacy high.
URLSCAN_VISIBILITY="unlisted"

# URLSCAN Trigger Thresholds: Only suspicious/uncertain URLs within this ML risk range trigger sandbox analysis.
URLSCAN_MIN_RISK_SCORE=35
URLSCAN_MAX_RISK_SCORE=85
URLSCAN_POLL_TIMEOUT_MS=25000
URLSCAN_MAX_RETRIES=10


# Optional split deployment: Vercel frontend + separately hosted Node backend.
# Leave blank when the Node server serves the frontend itself.
VITE_API_BASE_URL=""

# SOC role keys. Generate independent random values with >=32 characters.
# Never use VITE_ prefixes for these secrets or commit their values.
NEUROSHIELD_ADMIN_KEY=""
NEUROSHIELD_ANALYST_KEY=""
NEUROSHIELD_INTEL_DB="data/intelligence.sqlite"

# Controlled deception is always disabled on startup, including after restart.
# An administrator must enable it through the SOC UI after the local Docker image exists.
